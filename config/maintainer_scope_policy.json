{
  "schema_version": 1,
  "default_owner": "GENERAL",
  "owners": {
    "GENERAL": {
      "prefixes": [
        ".github/",
        "docs/",
        "plans/",
        "project/",
        "schemas/",
        "setup/",
        "tools/"
      ],
      "exact": [
        ".gitignore",
        "AGENTS.md",
        "CHANGELOG.md",
        "CONTEXT.md",
        "README.md",
        "START_HERE.md",
        "manifest.json",
        "requirements.txt"
      ]
    },
    "ANISSA_MAINTAINER": {
      "prefixes": [
        "anissa/",
        "automation_specs/",
        "chat_roles/",
        "logic/",
        "migrations/",
        "persona/",
        "profile/",
        "prompts/"
      ],
      "exact": []
    },
    "SOLDIERS_MAINTAINER": {
      "prefixes": [
        "soldiers/"
      ],
      "exact": []
    }
  },
  "publication": {
    "publisher": "GENERAL",
    "projection_builder": "tools/build_public_release.py",
    "safety_gate": "tools/public_safety.py",
    "eligibility": "ALLOWLIST_AND_SAFETY_GATE",
    "excluded_state_roots": [
      "brain/",
      "persona/",
      "profile/",
      "runtime/",
      "shared/",
      "soldiers/thula/private/",
      "soldiers/thula/tests/",
      "soldiers/thula/dashboard/assets/"
    ],
    "rule": "Every maintainer must route verified public-safe fixes into the public release. Atomic maintainers hand off publication to General; General alone generates, audits and pushes the allowlisted public projection. Private-instance and private-persona changes remain local."
  },
  "coordination": {
    "transport": "persistent_task_messages",
    "checkpoints": [
      "SCOPE",
      "ACK",
      "HANDOFF",
      "RECEIVED",
      "INTEGRATED_OR_REPAIR_REQUIRED",
      "PUBLISHED"
    ],
    "single_writer_per_file_scope": true,
    "silence_is_acceptance": false,
    "general_closes_cross_scope_work": true,
    "anissa_role_update_notes": {
      "owner": "GENERAL",
      "required_before_closure": true,
      "delivery_must_be_verified": true,
      "targets": [
        "COMMAND",
        "WEEKDAY_OPS",
        "WEEKEND"
      ],
      "content": [
        "deployed_version",
        "changed_behavior_or_interfaces",
        "preserved_invariants",
        "user_action_required"
      ],
      "implementation_only_updates_state_behavior_unchanged": true,
      "request_acknowledgement": false,
      "format": "compact_delta_only"
    }
  },
  "local_deployment": {
    "dashboard_freshness_command": "python -B soldiers/thula/cli.py ensure-server --host 127.0.0.1 --port 8765",
    "success_states": [
      "running",
      "started",
      "restarted"
    ],
    "rule": "A code maintenance change is not operationally complete until verification passes and the dashboard health build_id matches the current checkout. The command may replace only a process verified as Thula-owned."
  },
  "rule": "Evaluate scope before execution. Atomic work stays with its owner; mixed or unknown scope defers to General. General may perform global or atomic maintenance."
}
